# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project settings -> API keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Used solely by the submit handler (see docs/PLAN.md section 5a). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# AI (Gemini via Vercel AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
AI_MODEL=gemini-3.8-flash
# Optional: used once when AI_MODEL returns a rate-limit error
AI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Public base URL (used to build share/resume links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
